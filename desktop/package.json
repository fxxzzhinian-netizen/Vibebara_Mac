{
  "name": "@vibebara/desktop",
  "version": "1.3.1",
  "private": true,
  "description": "Vibebara 桌面客户端外壳（Electron / 方案 B M5-a）。主进程负责：拉起并守护本地代理 local-agent、生成并注入配对令牌、注入 window.__VIBEBARA_RUNTIME__ 运行时配置、用 safeStorage 安全存储登录 token、重做一键启动 launcher。渲染层复用 frontend/dist 构建产物。",
  "author": "DAIL",
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dev": "tsc -p tsconfig.json && electron .",
    "smoke:agent": "node scripts/smoke-agent.cjs",
    "smoke:cli": "node scripts/verify-cli-bundle.cjs",
    "test:cli-path": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-cli-path.ps1",
    "release:check": "node scripts/validate-release-env.cjs",
    "pack:win": "electron-builder --win --dir",
    "dist:win:unsigned": "electron-builder --config electron-builder.yml --win --publish never",
    "dist:win": "npm run release:check && electron-builder --config electron-builder.release.yml --win --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vibebara",
    "electron",
    "desktop",
    "local-agent"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
